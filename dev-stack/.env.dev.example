# ===========================================================================
# DEV ONLY — these are NOT the production secrets.
#
# The production credentials come from the Ansible defaults / Vault
# (heriverse-ansible), never from this repository. Everything here is a value
# chosen so a laptop stack comes up without a decision, and every one of them
# would be a vulnerability on anything reachable.
#
#   cp .env.dev.example .env.dev      # then edit only if a port collides
# ===========================================================================

# --- object store ----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=em-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- identity --------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# 8080 is a busy port on a developer's machine (this one already had a Moodle on
# it), so the dev stack does not claim it. Change it here if 8085 is taken too.
KEYCLOAK_PORT=8085
# Seeded by keycloak/realm-em-dev.json — change them there, not only here.
DEV_REALM=em-dev
DEV_CLIENT_ID=em-server
DEV_CLIENT_SECRET=em-dev-secret
DEV_USER=dev
DEV_PASSWORD=dev

# --- images (IIIF) ----------------------------------------------------------
# Cantaloupe reads the SAME bucket, with the asset's sha256 as the identifier.
CANTALOUPE_PORT=8182

# --- the room ---------------------------------------------------------------
EM_SERVER_PORT=8000
# What EMStudio and the manifests should use as the IIIF Image API base. In the
# dev stack that is Cantaloupe on localhost; behind Caddy in production it is
# https://<host>/iiif/3.
EM_IIIF_BASE=http://localhost:8182/iiif/3
