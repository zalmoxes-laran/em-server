# local Claude Code tooling — never committed
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/

# Nothing else belongs here: em-server is STATELESS. If this file ever needs an
# entry for uploads, a database or a session directory, that is the signal that
# something has been added which breaks the 12-factor property — fix the code,
# not the ignore list.

# The dev-stack's FILLED-IN environment. `.env.dev.example` is committed (it is
# documentation and its values are deliberately worthless); the copy somebody
# edits is not, because the day it stops holding `minioadmin` is the day it
# holds something real.
dev-stack/.env.dev

# macOS
.DS_Store
